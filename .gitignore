*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.user
*.userosscache
*.sln.docstates

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Debug / symbol files
*.pdb
*.ilk
*.exp

# Unreal generated folders
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/

# Unreal plugin generated folders
**/Plugins/**/Binaries/
**/Plugins/**/Intermediate/

# Build folder
**/Build/*

# Keep Build folder structure
!**/Build/*/
**/Build/*/**
!**/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!**/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga